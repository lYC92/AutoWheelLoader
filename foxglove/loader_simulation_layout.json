{
  "configById": {
    "Tab!loader": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "整车总览",
          "layout": {
            "direction": "row",
            "first": {
              "direction": "column",
              "first": "Plot!drive",
              "second": {
                "direction": "row",
                "first": "Plot!hydraulics",
                "second": "Plot!soil",
                "splitPercentage": 50
              },
              "splitPercentage": 48
            },
            "second": {
              "direction": "column",
              "first": {
                "direction": "row",
                "first": "Gauge!speed",
                "second": "Gauge!payload",
                "splitPercentage": 50
              },
              "second": "RawMessages!vehicle",
              "splitPercentage": 31
            },
            "splitPercentage": 69
          }
        },
        {
          "title": "ROS 节点与消息",
          "layout": {
            "direction": "row",
            "first": "TopicGraph!graph",
            "second": {
              "direction": "column",
              "first": "RawMessages!command",
              "second": {
                "direction": "column",
                "first": "RawMessages!interaction",
                "second": "RawMessages!terrain",
                "splitPercentage": 50
              },
              "splitPercentage": 34
            },
            "splitPercentage": 68
          }
        },
        {
          "title": "手动控制",
          "layout": {
            "direction": "row",
            "first": {
              "direction": "column",
              "first": "Markdown!controlHelp",
              "second": {
                "direction": "row",
                "first": "Teleop!drive",
                "second": "Teleop!hydraulics",
                "splitPercentage": 50
              },
              "splitPercentage": 28
            },
            "second": {
              "direction": "column",
              "first": {
                "direction": "row",
                "first": {
                  "direction": "column",
                  "first": "Publish!enable",
                  "second": "Publish!disable",
                  "splitPercentage": 50
                },
                "second": {
                  "direction": "column",
                  "first": "Publish!estop",
                  "second": "Publish!estopRelease",
                  "splitPercentage": 50
                },
                "splitPercentage": 50
              },
              "second": {
                "direction": "column",
                "first": "RawMessages!manualStatus",
                "second": "RawMessages!manualCommand",
                "splitPercentage": 35
              },
              "splitPercentage": 31
            },
            "splitPercentage": 62
          }
        },
        {
          "title": "感知与三维",
          "layout": {
            "direction": "row",
            "first": {
              "direction": "column",
              "first": "3D!vehiclePerception",
              "second": "3D!observerPerception",
              "splitPercentage": 50
            },
            "second": {
              "direction": "column",
              "first": "Plot!imu",
              "second": {
                "direction": "column",
                "first": "RawMessages!imu",
                "second": "RawMessages!pointcloud",
                "splitPercentage": 50
              },
              "splitPercentage": 42
            },
            "splitPercentage": 67
          }
        },
        {
          "title": "第四阶段·传感器",
          "layout": {
            "direction": "row",
            "first": "3D!effectPerception",
            "second": {
              "direction": "column",
              "first": "RawMessages!effectCloud",
              "second": "Plot!imu",
              "splitPercentage": 45
            },
            "splitPercentage": 65
          }
        },
        {
          "title": "第四阶段·定位",
          "layout": {
            "direction": "row",
            "first": "3D!localization",
            "second": {
              "direction": "column",
              "first": "Plot!localization",
              "second": "RawMessages!localization",
              "splitPercentage": 50
            },
            "splitPercentage": 65
          }
        }
      ]
    },
    "Plot!drive": {
      "foxglovePanelTitle": "行驶与车轮速度",
      "paths": [
        {
          "value": "/loader/state.longitudinal_speed_mps",
          "label": "车速 m/s",
          "enabled": true,
          "timestampMethod": "headerStamp"
        },
        {
          "value": "/loader/state.wheel_speed_radps[:]",
          "label": "车轮 rad/s",
          "enabled": true,
          "timestampMethod": "headerStamp"
        },
        {
          "value": "/loader/command.traction_torque_nm",
          "label": "牵引扭矩 N·m",
          "enabled": false,
          "timestampMethod": "headerStamp"
        }
      ],
      "xAxisVal": "timestamp",
      "timeRange": "latest",
      "timeWindowMode": "sliding",
      "followingViewWidth": 20,
      "legendDisplay": "top",
      "showLegend": true,
      "isSynced": true
    },
