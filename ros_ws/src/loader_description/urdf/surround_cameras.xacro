<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Matched perspective RGBD and semantic cameras. The capture tool applies
       the same equidistant map to all channels (160 degree circular FOV). -->
  <xacro:macro name="surround_camera" params="name xyz yaw">
    <link name="camera_${name}_link"><inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial></link>
    <joint name="camera_${name}_mount" type="fixed"><parent link="rear_frame"/><child link="camera_${name}_link"/><origin xyz="${xyz}" rpy="0 0.35 ${yaw}"/></joint>
    <gazebo reference="camera_${name}_mount"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="camera_${name}_link">
      <sensor name="${name}_rgbd" type="rgbd_camera">
        <always_on>true</always_on><update_rate>10</update_rate><topic>/loader/cameras/${name}/raw</topic>
        <camera><horizontal_fov>2.792526803190927</horizontal_fov><image><width>640</width><height>640</height><format>R8G8B8</format></image><clip><near>0.1</near><far>40</far></clip></camera>
      </sensor>
      <sensor name="${name}_semantic" type="segmentation_camera">
        <always_on>true</always_on><update_rate>10</update_rate><topic>/loader/cameras/${name}/semantic</topic>
        <camera><segmentation_type>panoptic</segmentation_type><horizontal_fov>2.792526803190927</horizontal_fov><image><width>640</width><height>640</height><format>R8G8B8</format></image><clip><near>0.1</near><far>40</far></clip></camera>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:macro name="surround_cameras" params="">
    <xacro:surround_camera name="front" xyz="0.9 0 2.5" yaw="0"/>
    <xacro:surround_camera name="left" xyz="-0.85 1.45 2.3" yaw="${pi/2}"/>
    <xacro:surround_camera name="rear" xyz="-3.4 0 2.3" yaw="${pi}"/>
    <xacro:surround_camera name="right" xyz="-0.85 -1.45 2.3" yaw="${-pi/2}"/>
  </xacro:macro>
</robot>
